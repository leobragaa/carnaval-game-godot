[sub_resource type="GDScript" id="GDScript_hho03"]
script/source = "
extends Area2D

signal vitoria

var jogador_dentro := false
var tempo_seguro := 0.0
var venceu := false
var ultima_posicao := -1

@export var tempo_necessario := 60.0

@onready var timer_mudanca: Timer = $Timer
@onready var pontos_zona: Node2D = $\"../Node2D\"


func _ready() -> void:
	body_entered.connect(_entrou)
	body_exited.connect(_saiu)

	timer_mudanca.wait_time = 10.0
	timer_mudanca.timeout.connect(_mudar_local)

	_mudar_local()
	timer_mudanca.start()


func _process(delta: float) -> void:
	if jogador_dentro and not venceu:
		tempo_seguro += delta

	if tempo_seguro >= tempo_necessario and not venceu:
		venceu = true
		print(\"VITORIA !!!\")
		vitoria.emit()


func _entrou(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		jogador_dentro = true


func _saiu(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		jogador_dentro = false

func esconder_desenhos() -> void:
	for ponto in pontos_zona.get_children():
		var desenho = ponto.get_node(\"Sprite2D\")
		desenho.visible = false
		
func _mudar_local() -> void:
	var locais = pontos_zona.get_children()

	if locais.is_empty():
		return

	var indice = randi_range(0, locais.size() - 1)
	var ponto_escolhido = locais[indice]
	
	while locais.size() > 1 and indice == ultima_posicao:
		indice = randi_range(0, locais.size() - 1)
	
	for ponto in locais:
		ponto.get_node(\"Sprite2D\").visible = false
		
	jogador_dentro = false
	esconder_desenhos()
	global_position = ponto_escolhido.global_position
	print(\"Zona mudou para: \", ponto_escolhido.name)
	print(\"Nova posição: \", global_position)
	ultima_posicao = indice
	
"

